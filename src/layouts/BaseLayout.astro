---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '小径 · Tipath',
  description = '小径通幽，日有所进。小事之间，自有其法。'
} = Astro.props;

const pageTitle = title === '小径 · Tipath' ? title : `${title} · 小径`;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={base}>
          <span class="brand-cn">小径</span>
          <span class="brand-en">Tipath</span>
        </a>
        <p class="slogan">小径通幽，日有所进。小事之间，自有其法。</p>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>Tipath</span>
        <span>小径通幽</span>
      </footer>
    </div>
  </body>
</html>
