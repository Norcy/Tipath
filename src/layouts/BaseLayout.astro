---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '小径 · Tipath',
  description = '小径通幽，日有所进。小事之间，自有其法。'
} = Astro.props;

const pageTitle = title === '小径 · Tipath' ? title : `${title} · 小径`;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialTitle = pageTitle;
const socialDescription = description || '小径通幽，日有所进。小事之间，自有其法。';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={socialDescription} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="小径 · Tipath" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />

    <meta name="theme-color" content="#f6f4ef" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={base}>
          <span class="brand-cn">小径</span>
          <span class="brand-en">Tipath</span>
        </a>
        <p class="slogan">小径通幽，日有所进。小事之间，自有其法。</p>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>Tipath</span>
        <span>小径通幽</span>
      </footer>
    </div>
  </body>
</html>
