---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  compact?: boolean;
  bare?: boolean;
}

const {
  title = '小径 · Tipath',
  description = '小径通幽，日有所进。小事之间，自有其法。',
  compact = false,
  bare = false
} = Astro.props;

const pageTitle = title === '小径 · Tipath' ? title : `${title} · 小径`;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialTitle = pageTitle;
const socialDescription = description || '小径通幽，日有所进。小事之间，自有其法。';
const shareImage = new URL(`${base}share-icon.png`, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={socialDescription} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="小径 · Tipath" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="小径 · Tipath" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={shareImage} />
    <meta itemprop="image" content={shareImage} />
    <link rel="image_src" href={shareImage} />

    <meta name="theme-color" content="#0f5a43" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
  </head>
  <body>
    <img src={shareImage} alt="" width="1" height="1" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:.01" />
    <div class="site-shell">
      {!bare && (compact ? (
        <header class="site-header site-header-compact">
          <a class="compact-brand" href={base}>小径</a>
        </header>
      ) : (
        <header class="site-header">
          <a class="brand" href={base}>
            <span class="brand-cn">小径</span>
            <span class="brand-en">Tipath</span>
          </a>
          <p class="slogan">小径通幽，日有所进。小事之间，自有其法。</p>
        </header>
      ))}
      <main>
        <slot />
      </main>
      {!compact && !bare && (
        <footer class="site-footer">
          <span>Tipath</span>
          <span>小径通幽</span>
        </footer>
      )}
    </div>
  </body>
</html>
