---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const tips = (await getCollection('tips'))
  .filter((tip) => !tip.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tags = [...new Set(tips.flatMap((tip) => tip.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh-CN')
);
---
<BaseLayout bare>
  <section class="home" aria-label="Tips">
    <div class="home-head">
      <h1 class="home-title">小径</h1>
      <button
        id="search-toggle"
        class="search-toggle"
        type="button"
        aria-label="搜索"
        aria-expanded="false"
        aria-controls="search-panel"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div id="search-panel" class="search-panel" hidden>
      <input id="search" class="search" type="search" placeholder="搜索…" autocomplete="off" />
      <div class="tags" aria-label="标签筛选">
        <button class="tag-button active" data-tag="">全部</button>
        {tags.map((tag) => <button class="tag-button" data-tag={tag}>{tag}</button>)}
      </div>
    </div>

    <div id="tip-list" class="tip-list tip-list-minimal">
      {tips.map((tip, index) => (
        <a
          class="tip-row"
          href={`${base}tips/${tip.id}/`}
          data-title={tip.data.title.toLowerCase()}
          data-tags={JSON.stringify(tip.data.tags.map((tag) => tag.toLowerCase()))}
        >
          <span class="tip-number">#{String(tips.length - index).padStart(3, '0')}</span>
          <span class="tip-row-title">{tip.data.title}</span>
        </a>
      ))}
    </div>

    <div id="empty-state" class="empty-state">没有找到匹配的内容。</div>
  </section>

  <script is:inline>
    const toggle = document.querySelector('#search-toggle');
    const panel = document.querySelector('#search-panel');
    const search = document.querySelector('#search');
    const rows = [...document.querySelectorAll('.tip-row')];
    const tagButtons = [...document.querySelectorAll('.tag-button')];
    const empty = document.querySelector('#empty-state');
    let activeTag = '';

    const applyFilter = () => {
      const query = (search?.value || '').trim().toLowerCase();
      let visible = 0;

      rows.forEach((row) => {
        const title = row.dataset.title || '';
        let tags = [];
        try {
          tags = JSON.parse(row.dataset.tags || '[]');
        } catch {}

        const matchQuery = !query || title.includes(query) || tags.some((tag) => tag.includes(query));
        const matchTag = !activeTag || tags.includes(activeTag.toLowerCase());
        const show = matchQuery && matchTag;

        row.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      empty.style.display = visible ? 'none' : 'block';
    };

    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const willOpen = panel.hidden;
      panel.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
      if (willOpen) window.setTimeout(() => search?.focus(), 0);
    });

    search?.addEventListener('input', applyFilter);

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeTag = button.dataset.tag || '';
        tagButtons.forEach((item) => item.classList.toggle('active', item === button));
        applyFilter();
      });
    });
  </script>
</BaseLayout>
