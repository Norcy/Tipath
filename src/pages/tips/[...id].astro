---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tips = (await getCollection('tips')).filter((tip) => !tip.data.draft);
  return tips.map((tip) => ({
    params: { id: tip.id },
    props: { tip }
  }));
}

const { tip } = Astro.props;
const { Content } = await render(tip);
const base = import.meta.env.BASE_URL;

const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(tip.data.date);
---
<BaseLayout title={tip.data.title} description={tip.data.summary}>
  <article class="article">
    <a class="back-link" href={base}>← 返回小径</a>
    <div class="article-meta">
      <span>{date}</span>
      {tip.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
    <h1>{tip.data.title}</h1>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
